# GeoAI Platform Environment Configuration

# --- Database ---
DB_URL=postgresql://user:pass@localhost:5432/meghalaya_spatial

# --- SMTP Email Configuration ---
# Required for real email delivery. If missing, emails will be mocked.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- LLM Service ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
